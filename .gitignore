# ==========================================
# AI Data Analyst — .gitignore
# ==========================================

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Databases & Local Data Artifacts
*.sqlite
*.sqlite3
*.db
data/storage/*
!data/storage/.gitkeep
kaggle_downloads/*
!kaggle_downloads/.gitkeep
outputs/charts/*.png
outputs/reports/*.md
!outputs/charts/.gitkeep
!outputs/reports/.gitkeep

# Node & Next.js
node_modules/
**/node_modules/
apps/web/node_modules/
.next/
**/.next/
apps/web/.next/
out/
apps/web/out/
.turbo/
apps/web/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
